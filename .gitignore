# ── 데이터 (절대 커밋 금지) ──────────────────────────────
# 확장자가 아니라 폴더 단위로 막는다. *.jpg 같은 규칙만 두면
# 나중에 확장자가 다른 파일(.jpeg, 좌표 txt 등)이 새어나간다.
dog_breed_dataset/
data/

# ── 개인 사진 ─────────────────────────────────────────────
# 내 강아지 사진과, 거기서 파생된 crop·결과 이미지까지 함께 막는다.
# (원본만 막고 결과물 폴더를 빼먹으면 그쪽으로 새어나간다)
my_photos/
photos/
# 추론 결과 — 개인 사진에서 잘라낸 crop과 bbox 이미지가 들어간다.
# 원본만 막고 파생 산출물을 빼먹으면 그쪽으로 새어나간다.
result/

# ── 실행하면 다시 생기는 산출물 ───────────────────────────
artifacts/
outputs/
runs/

# ── 모델 가중치 (자동 다운로드되므로 커밋 불필요) ─────────
